# Copy this file to a new file named ".env" and fill in your real values.
# Never share your real .env file with anyone.

# --- Database connection settings ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=faams
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# --- Security ---
# A random secret used to sign login tokens. Can be any long random text.
JWT_SECRET=change_this_to_a_long_random_string

# --- Server ---
PORT=5000
